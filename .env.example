# =============================================================================
# Scholar MS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On Vercel, set these in Project Settings → Environment Variables.
# Make sure to add them for BOTH "Preview" and "Production" environments.
# =============================================================================

# --- MySQL Database (server API routes) ---
# Used by server/utils/db.ts to connect to your MySQL database.
# If any of these are missing, the app will throw a clear error at runtime.

DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# --- Database SSL/TLS ---
# Controls whether TLS/SSL is used for the MySQL connection.
#   - "true"  → enable TLS with certificate validation (TiDB Cloud)
#   - "false" → disable TLS entirely (Clever Cloud shared tier, local dev)
#   - unset   → auto-detect: enable TLS only if the host looks like TiDB Cloud
#
# If you're on Clever Cloud's shared Dev-tier MySQL, set this to "false".
# If you're on TiDB Cloud, leave it unset (auto-detected) or set to "true".
DB_SSL=false

# --- JWT Auth ---
# Used to sign and verify auth tokens stored in httpOnly cookies.
# Generate a strong secret: openssl rand -base64 32
# On Vercel, set this in Project Settings → Environment Variables
# for BOTH "Preview" and "Production" environments.
JWT_SECRET=your-strong-random-jwt-secret-here

# --- Admin Login Credentials ---
# Used by the /login page to authenticate admin access.
# Change these in production!
ADMIN_EMAIL=admin@scholar.edu
ADMIN_PASSWORD=admin123

# --- Supabase (frontend client — optional, only if using Supabase) ---
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Legacy aliases (still supported) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
